{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kraken-failure-class/detection-row/v1",
  "title": "A failure-class detection (cue) row",
  "description": "One machine-readable tripwire. CLOSED and engine-specific: awk-ere rows contain exactly {engine, pattern, cue_ref}; ast-grep rows contain exactly {engine, rule_id, cue_ref}. Any undeclared key fails.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "pattern", "cue_ref"],
      "properties": {
        "engine": { "const": "awk-ere" },
        "pattern": { "type": "string", "minLength": 1 },
        "cue_ref": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "rule_id", "cue_ref"],
      "properties": {
        "engine": { "const": "ast-grep" },
        "rule_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "cue_ref": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
