{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "firstmate/governed-profile-frontmatter/v1",
  "title": "Governed profile frontmatter object",
  "description": "Closed, total schema for a .claude/agents/<profile>.md YAML frontmatter object (model-economy S3). additionalProperties:false admits only the projected key set, each fully typed. The two conditional keys are made total declaratively: EFFORT is required for every non-haiku model and forbidden for haiku; disallowedTools is exactly [\"Agent\"] and required when the Agent tool is absent (non-nesting) and forbidden when Agent is present (nesting). Whole-object projection equality against the manifest additionally proves the values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "model", "tools", "maxTurns", "permissionMode", "profile_version"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "model": {"type": "string", "enum": ["haiku", "sonnet", "opus", "fable"]},
    "EFFORT": {"type": "string", "enum": ["low", "medium", "high", "xhigh", "max"]},
    "tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "disallowedTools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "maxTurns": {"type": "integer", "minimum": 1},
    "permissionMode": {"type": "string", "enum": ["default"]},
    "profile_version": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"required": ["model"], "properties": {"model": {"const": "haiku"}}},
      "then": {"not": {"required": ["EFFORT"]}},
      "else": {"required": ["EFFORT"]}
    },
    {
      "if": {"required": ["tools"], "properties": {"tools": {"contains": {"const": "Agent"}}}},
      "then": {"not": {"required": ["disallowedTools"]}},
      "else": {"required": ["disallowedTools"], "properties": {"disallowedTools": {"const": ["Agent"]}}}
    }
  ]
}
