{
  "schema": "firstmate/scanner-adjudicator-policy/1",
  "prompt_version": "scanner-adjudicator-v2",
  "models": {
    "default": "claude-haiku-4-5-20251001",
    "escalation": "claude-sonnet-4-5-20250929"
  },
  "limits": {
    "timeout_s": 20,
    "max_findings": 32,
    "max_hunk_chars": 4000,
    "max_message_chars": 1000,
    "max_reason_chars": 240,
    "max_evidence_chars": 240,
    "max_cost_usd": 0.05,
    "audit_sample_k": 2
  },
  "cost_estimate": {
    "chars_per_token": 4,
    "default": {
      "input_usd_per_million_tokens": 1,
      "output_usd_per_million_tokens": 5
    },
    "escalation": {
      "input_usd_per_million_tokens": 3,
      "output_usd_per_million_tokens": 15
    }
  },
  "never_adjudicate_scanners": [
    "gitleaks"
  ],
  "selectors": [
    {
      "scanner": "eslint",
      "rule_prefix": "security/",
      "finding_class": "security-heuristic"
    },
    {
      "scanner": "osv-scanner",
      "rule_prefix": "dev-dependency/",
      "finding_class": "dev-dependency-advisory"
    }
  ],
  "reason_taxonomy": [
    {
      "code": "test-fixture",
      "corroborator": "trusted-test-fixture-manifest",
      "description": "A machine-owned fixture manifest independently proves that the exact finding is synthetic and is not shipped."
    },
    {
      "code": "constant-safe-value",
      "corroborator": "trusted-static-dataflow-literal",
      "description": "A machine-owned static dataflow proof independently proves that the exact flagged value is a fixed safe literal."
    },
    {
      "code": "guarded-by-allowlist",
      "corroborator": "trusted-ast-dominating-allowlist",
      "description": "A machine-owned AST proof independently proves that a closed allowlist check dominates the exact flagged operation."
    },
    {
      "code": "dev-only-package",
      "corroborator": "candidate-package-lock-dev-scope",
      "description": "The application independently re-read the candidate package-lock and proved that the exact affected package is marked dev-only."
    }
  ]
}
